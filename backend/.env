PORT=5000
NODE_ENV=development
JWT_SECRET=bdl_rtgs_secret_jwt_key_2026_super_secure

# Base de Données MySQL
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rtgs_ebanking
DB_USER=root
DB_PASSWORD=

# Utiliser MySQL directement (false) ou SQLite (true)
USE_SQLITE_FALLBACK=false

# ==============================================================================
# MODE DE VÉRIFICATION DU SOLDE CORE BANKING (SAB)
# Valeurs possibles : 
#   - SIMULATION   : Mode test/développement avec table SAB simulée en mémoire
#   - ORACLE_PROD  : Mode production avec interrogation réelle du serveur Oracle 11g
# ==============================================================================
SOLDE_VERIFICATION_MODE=SIMULATION

# Paramètres de connexion Oracle 11g SAB (Actifs uniquement si SOLDE_VERIFICATION_MODE=ORACLE_PROD)
ORACLE_USER=sabstd
ORACLE_PASSWORD=sabpass
ORACLE_CONNECT_STRING=127.0.0.1:1521/SABDEV
# ORACLE_CLIENT_DIR=C:\oracle\instantclient_11_2

# Seuil RTGS en Dinars Algériens (DZD)
RTGS_MIN_AMOUNT=1000000
